    {
      "parameters": {
        "jsCode": "// 1. The Memory Notepad: This will track all the time blocks we assign DURING this exact run.\nconst sessionCalendar = {};\n\n// 2. The Rosters: We need a place to line up all the applicants for each ticket.\nconst rosters = {};\n\n// ==========================================\n// PHASE 1: Build the Rosters\n// ==========================================\nfor (let item of items) {\n  // If they are already a LOSER (e.g., missing start time), ignore them completely.\n  if (item.json.Status === \"LOSER\") continue;\n\n  const tId = item.json.ticketID;\n  const email = item.json.ExtractedEmail;\n  \n  // We need absolute numbers to do math. Convert the reply date to a Number.\n  const replyTime = Number(item.json.internalDate);\n  \n  // Convert their proposed work time into absolute milliseconds for our clash math.\n  const startMs = new Date(item.json.start_time).getTime();\n  // Duration is in minutes. Multiply by 60,000 to get milliseconds.\n  const endMs = startMs + (item.json.duration_minutes * 60000);\n\n  // If this ticket doesn't have a roster yet, create a blank line.\n  if (!rosters[tId]) {\n    rosters[tId] = [];\n  }\n\n  // Put this applicant in the line for this ticket.\n  rosters[tId].push({\n    msgId: item.json.id,\n    email: email,\n    replyTime: replyTime,\n    startMs: startMs,\n    endMs: endMs,\n    originalItem: item // We keep a reference so we can easily stamp them later!\n  });\n}\n\n// ==========================================\n// PHASE 2: The Draft & Clash Check\n// ==========================================\n\n// Now we look at each ticket's roster one by one.\nfor (const tId in rosters) {\n  \n  // Sort the line of applicants from fastest reply (lowest) to slowest (highest).\n  const line = rosters[tId].sort((a, b) => a.replyTime - b.replyTime);\n\n  let ticketAwarded = false;\n\n  // Walk down the line, starting with the fastest person...\n  for (const candidate of line) {\n    const email = candidate.email;\n\n    // If this worker isn't on our memory notepad yet, add a blank page for them.\n    if (!sessionCalendar[email]) {\n      sessionCalendar[email] = [];\n    }\n\n    // Check their personal notepad to see if they are already booked.\n    let hasClash = false;\n    for (const bookedTime of sessionCalendar[email]) {\n      // The Golden Rule of Time Overlap: (Start A < End B) AND (End A > Start B)\n      if (candidate.startMs < bookedTime.endMs && candidate.endMs > bookedTime.startMs) {\n        hasClash = true;\n        break; // Stop checking, they are booked!\n      }\n    }\n\n    // Did they pass the test?\n    if (!hasClash && !ticketAwarded) {\n      // We found our winner! Stamp their original item.\n      candidate.originalItem.json.Status = \"WINNER\";\n      \n      // CRITICAL: Write this new job down on their notepad so they don't get double-booked on the next ticket.\n      sessionCalendar[email].push({\n        startMs: candidate.startMs,\n        endMs: candidate.endMs\n      });\n      \n      ticketAwarded = true; // The ticket is gone, move to the next ticket ID.\n    } else {\n      // If they clashed, or if someone faster already took the ticket, they get the loser stamp.\n      candidate.originalItem.json.Status = \"LOSER\";\n    }\n  }\n}\n\n// ==========================================\n// PHASE 3: The Cleanup\n// ==========================================\n// Just to be absolutely certain, anyone who didn't get a WINNER stamp is officially a LOSER.\nfor (let item of items) {\n  if (item.json.Status !== \"WINNER\") {\n    item.json.Status = \"LOSER\";\n  }\n}\n\nreturn items;"
      },
