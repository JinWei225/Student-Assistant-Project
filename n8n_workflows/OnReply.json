      "parameters": {
        "jsCode": "// 1. Get the raw text output. \n// CHANGE 'llm_output' to the actual field name where LLM stores its response.\nconst rawText = $input.first().json.content;\n\nif (!rawText) {\n  throw new Error(\"Critical Failure: No data received from the LLM node.\");\n}\n\n// 2. The Regex Trap: Hunt specifically for the JSON array structure.\n// This ignores markdown, introductory text, and conversational filler.\nconst jsonMatch = rawText.match(/\\[[\\s\\S]*\\]/);\n\nif (!jsonMatch) {\n  throw new Error(\"Parsing Failure: LLM did not return a recognizable JSON array. Raw output: \" + rawText);\n}\n\ntry {\n  // 3. Parse the isolated JSON string\n  const parsedData = JSON.parse(jsonMatch[0]);\n  \n  // 4. Structural Reformatting: \n  // We batched the emails earlier. Now, we split them back into individual n8n items \n  // so you can process each start_time/duration independently in your next nodes.\n  return parsedData.map(item => ({\n    json: item\n  }));\n\n} catch (error) {\n  // 5. Fail loud, fail clear.\n  throw new Error(\"JSON Parse Error: The LLM hallucinated an invalid JSON structure. \" + error.message);\n}"
