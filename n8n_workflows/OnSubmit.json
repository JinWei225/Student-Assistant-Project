        "messages": {
          "values": [
            {
              "content": "=You are an expert university maintenance dispatcher. Below is a list of maintenance reports. For each report, analyze the 'description' and estimate the duration of the repair in minutes. Provide the output as a JSON array of objects, each containing the 'id' and a new field 'estimated_minutes'. Be realistic: assume a single worker is performing the task.\nNEVER WRITE THE WORD 'json'\nReports: {{ $json.all_tickets_string }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        1264,
        16
      ],
      "id": "0f5e4e2a-b10a-468e-a46f-99bbd215a50b",
      "name": "EstimateDuration",
      "credentials": {
        "ollamaApi": {
          "id": "f8F4oOkrWlj1YyF6",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rawContent = $json.content;\nlet jsonString = rawContent;\n\n// Check if the model used the standard markdown code block\nif (rawContent.includes(\"```json\")) {\n    jsonString = rawContent.split(\"```json\")[1].split(\"```\")[0];\n} \n// Fallback just in case the model forgets the backticks but outputs \"json\"\nelse if (rawContent.includes(\"json\")) {\n    jsonString = rawContent.split(\"json\")[1];\n    \n    if (jsonString.lastIndexOf(\"]\") !== -1) {\n        jsonString = jsonString.substring(0, jsonString.lastIndexOf(\"]\") + 1);\n    }\n}\n\n// Trim any leftover whitespace or newlines\njsonString = jsonString.trim();\n\n// Parse the clean string into a JavaScript object or array\nconst parsedData = JSON.parse(jsonString);\n\n// --- THE FIX: The Dimensionality Check ---\n// We use Array.isArray() to verify if the parsed data is a list.\n// If it is NOT a list, we manually wrap it in brackets to force it into a list format.\nconst estimates = Array.isArray(parsedData) ? parsedData : [parsedData];\n\n// Now, .map() is guaranteed to work because 'estimates' is ALWAYS an array.\nreturn estimates.map(item => ({ json: item }));"
      },
