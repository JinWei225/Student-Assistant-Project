    {
      "parameters": {
        "jsCode": "let newTickets = [];\nlet pendingTickets = [];\n\ntry { newTickets = $items(\"GetUnbroadcastedTickets\"); } catch (e) { newTickets = []; }\ntry { pendingTickets = $items(\"GetPendingTickets\"); } catch (e) { pendingTickets = []; }\n\nconst tickets = [...newTickets, ...pendingTickets];\n\nconst ticketString = tickets.map(t => {\n  return `ID: ${t.json.id} | Category: ${t.json.issue_category} | Description: ${t.json.description}`;\n}).join('\\n'); \n\nreturn {\n  all_tickets_string: ticketString\n};"
      },
