    {
      "parameters": {
        "jsCode": "if ($input.context.itemIndex > 0) return []; \n\nconst allTickets = $items(\"AddEstimatedMinutes\");\nconst workers = $items(\"GetAvailableWorkers\");\nlet results = [];\n\nfor (const ticket of allTickets) {\n  for (const worker of workers) {\n    // Check if the ticket department matches the worker's department\n    if (ticket.json.department === worker.json.department) {\n      results.push({\n        json: {\n          ticket_id: ticket.json.id,\n          department: ticket.json.department,\n          block_room_no: ticket.json.block_room_no,\n          student_name: ticket.json.student_name,\n          student_telephone: ticket.json.student_telephone,\n          issue_category: ticket.json.issue_category,\n          worker_email: worker.json.email,\n          description: (ticket.json.description || \"\").trim(),\n          estimated_minutes: ticket.json.estimated_minutes\n        }\n      });\n    }\n  }\n}\n\nreturn results;"
      },
